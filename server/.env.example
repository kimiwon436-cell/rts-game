# 이 파일을 .env로 복사해서 쓴다. (.env는 커밋되지 않는다)

# 서버 포트. Render에서는 자동으로 주입된다.
PORT=3000

# 접속을 허용할 클라이언트 주소. 쉼표로 구분한다.
CLIENT_ORIGINS=http://localhost:5173

# Firebase 서비스 계정 JSON을 Base64로 인코딩한 값.
# 비워 두면 개발 모드: Firebase 없이 게스트 토큰(dev:...)으로 접속한다.
# NODE_ENV=production 에서 비어 있으면 서버가 시작되지 않는다.
FIREBASE_SERVICE_ACCOUNT=

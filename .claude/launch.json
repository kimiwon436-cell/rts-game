{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "server"
      ],
      "port": 3000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "server-devmode",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/src/index.js"
      ],
      "port": 3000
    }
  ]
}

{
  "name": "rune-and-crown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
